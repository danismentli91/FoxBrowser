<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#080C11">
 <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:paddingHorizontal="8dp">
  <ImageView android:id="@+id/foxLogo" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/fox_logo" android:contentDescription="FoxBrowser" android:padding="3dp"/>
  <ImageButton android:id="@+id/back" android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="Geri" android:src="@android:drawable/ic_media_previous" android:background="@android:color/transparent"/>
  <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:hint="Ara veya web adresi yaz" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#82909B" android:backgroundTint="#9C5B43"/>
  <Button android:id="@+id/go" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Git"/>
 </LinearLayout>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:fillViewport="true"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:paddingHorizontal="4dp">
  <Button android:id="@+id/home" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Ana sayfa"/><Button android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Yenile"/><Button android:id="@+id/desktop" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Masaüstü"/><Button android:id="@+id/privateMode" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Gizli"/><Button android:id="@+id/voice" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Sesli ara"/><Button android:id="@+id/openFile" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Dosya aç"/><Button android:id="@+id/downloadFolder" android:layout_width="wrap_content" android:layout_height="44dp" android:text="İndirme yolu"/><Button android:id="@+id/share" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Paylaş"/><Button android:id="@+id/keyboard" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Klavye"/><Button android:id="@+id/terminal" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Terminal"/><Button android:id="@+id/settings" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Ayarlar"/>
 </LinearLayout></HorizontalScrollView>
 <ScrollView android:id="@+id/homeDashboard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="22dp">
  <ImageView android:layout_width="128dp" android:layout_height="128dp" android:src="@drawable/fox_logo" android:contentDescription="Mor tilki logosu"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FoxBrowser" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Web • Linux • Dosyalar • Araçlar" android:textColor="#C6B6AF" android:textSize="15sp" android:layout_marginBottom="18dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/quickWeb" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="🌐 Web"/><Button android:id="@+id/quickWhatsApp" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="WhatsApp"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/quickTerminal" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="⌨ Terminal"/><Button android:id="@+id/quickFiles" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="📁 Dosyalar"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/quickKeyboard" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="Klavye"/><Button android:id="@+id/quickSettings" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="⚙ Ayarlar"/></LinearLayout>
 </LinearLayout></ScrollView>
 <org.mozilla.geckoview.GeckoView android:id="@+id/geckoView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone"/>
</LinearLayout>
